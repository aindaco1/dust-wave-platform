{
  "name": "@dustwave/platform-workspace",
  "version": "0.39.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run security:secrets && npm run security:audit && npm test",
    "security:secrets": "node scripts/scan-tracked-secrets.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "test": "node --test packages/*/test/*.test.js && npm run test:recipes",
    "test:recipes": "node scripts/test-recipes.mjs",
    "test:recipes:jekyll": "node scripts/test-recipes.mjs --jekyll"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "MIT",
  "devDependencies": {
    "linkedom": "0.18.12",
    "typescript": "7.0.2"
  }
}
